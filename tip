        "def main():\n",
        "    dollars = dollars_to_float(input(\"How much was the meal? \"))\n",
        "    percent = percent_to_float(input(\"What percent would you like to tip? \"))\n",
        "    tip =dollars*percent\n",
        "    print(f\"Leave ${tip:.2f}\")\n",
        "\n",
        "def dollars_to_float(d):\n",
        "    d = d.replace(\"$\",\"\")\n",
        "    return float(d)\n",
        "\n",
        "def percent_to_float(p):\n",
        "    p = p.replace(\"%\",\"\")\n",
        "    p = float(p)/100\n",
        "    return p\n",
        "\n",
